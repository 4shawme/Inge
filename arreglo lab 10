import java.util.Random;

public class Arreglo {
    public static void main(String[] args) {
        // Crear un arreglo de 100 números enteros
        int[] arreglo = new int[100];
        Random rand = new Random();

        // Llenar el arreglo con números aleatorios entre 1 y 200
        for (int i = 0; i < arreglo.length; i++) {
            arreglo[i] = rand.nextInt(200) + 1;
        }

        // Encontrar el número mayor y menor
        int numeroMayor = arreglo[0];
        int numeroMenor = arreglo[0];
        for (int num : arreglo) {
            if (num > numeroMayor) {
                numeroMayor = num;
            }
            if (num < numeroMenor) {
                numeroMenor = num;
            }
        }

        // Sumar el primer y el último elemento
        int sumaPrimeroUltimo = arreglo[0] + arreglo[arreglo.length - 1];

        // Verificar si existe el número 100
        boolean existeCien = false;
        for (int num : arreglo) {
            if (num == 100) {
                existeCien = true;
                break;
            }
        }

        // Mostrar los resultados
        System.out.println("Número mayor: " + numeroMayor);
        System.out.println("Número menor: " + numeroMenor);
        System.out.println("Suma del primer y último elemento: " + sumaPrimeroUltimo);
        if (existeCien) {
            System.out.println("Existe cien");
        } else {
            System.out.println("No existe cien");
        }
    }
}
