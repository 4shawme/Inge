public class ImprimirMatriz2024 {
    
    public static void main(String[] args) {
        // Definición de una matriz con varios valores
        int[][] arreglo = {
            {1, 2},
            {3},
            {4, 5, 6}
        };

        // Imprimir los valores de la matriz
        System.out.println("Los valores en arreglo son:");
        imprimirMatriz(arreglo);
    }
    
    // Función que imprime los valores de una matriz
    public static void imprimirMatriz(int[][] arreglo) {
        for (int fila = 0; fila < arreglo.length; fila++) {
            for (int columna = 0; columna < arreglo[fila].length; columna++) {
                System.out.print(arreglo[fila][columna] + " ");
            }
            System.out.println();  // Nueva línea después de cada fila
        }
    }
}
